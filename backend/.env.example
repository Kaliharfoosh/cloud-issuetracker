# Copy this file to .env and adjust the values for your machine.
# .env is listed in .gitignore and never reaches GitHub.

# The port the server will run on
PORT=3000
NODE_ENV=development

# Lab 5: browser origins allowed to call this API.
# Comma separated, each one scheme + host + port, no trailing slash and no path.
CORS_ORIGINS=http://localhost:8080

# Lab 5: Neon connection string (secret, never commit).
# Empty -> backend/data/issues.json is used (Lab 4 storage, local only).
# Set   -> Neon Postgres is used.
DATABASE_URL=

# Lab 7: DynamoDB table name.
# Empty -> Neon or the local JSON file is used.
# Set   -> the DynamoDB table of that name is used (takes priority over DATABASE_URL).
DYNAMODB_TABLE=
